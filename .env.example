# Enable on the approved production deployment when the site is ready for indexing.
SITE_INDEXING=disabled

# Use the verified 20-minute event. Until then, Contact offers email booking.
CALENDLY_EVENT_URL=

# Enquiry delivery. Use an approved test inbox in preview.
RESEND_API_KEY=
ENQUIRY_FROM_EMAIL=
ENQUIRY_TO_EMAIL=

# Approved JSON adapters for the existing survey and newsletter providers.
SURVEY_ENDPOINT=
SURVEY_ENDPOINT_TOKEN=
NEWSLETTER_ENDPOINT=
NEWSLETTER_ENDPOINT_TOKEN=

# Optional collector with Idempotency-Key support.
CONVERSION_ENDPOINT=
CONVERSION_ENDPOINT_TOKEN=
